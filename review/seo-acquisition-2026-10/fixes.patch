@@ -0,0 +1,26 @@
+<?php
+/** Keep client acquisition intent on a local, allowlisted portal route. */
+function clientReturnPath($candidate): string {
+    $fallback = '/dashboard';
+    if (!is_string($candidate) || $candidate === '' || strlen($candidate) > 4096) {
+        return $fallback;
+    }
+    if ($candidate[0] !== '/' || str_starts_with($candidate, '//') ||
+        str_contains($candidate, '\\') || preg_match('/[\x00-\x1F\x7F]/', $candidate) ||
+        preg_match('/%(?:0a|0d|00|5c)/i', $candidate)) {
+        return $fallback;
+    }
+    $parts = parse_url($candidate);
+    if ($parts === false || isset($parts['host']) || isset($parts['scheme']) || isset($parts['fragment'])) {
+        return $fallback;
+    }
+    $path = $parts['path'] ?? '';
+    $routes = ['dashboard', 'order', 'order-new', 'order-view', 'orders', 'billing',
+        'profile', 'preferences', 'support', 'completed-jobs', 'pending-jobs', 'review'];
+    foreach ($routes as $route) {
+        if (in_array($path, ['/' . $route, '/' . $route . '.php', '/' . $route . '/'], true)) {
+            return $candidate;
+        }
+    }
+    return $fallback;
+}
--- /dev/null
+++ b/includes/jsonld.php
@@ -0,0 +1,21 @@
+<?php
+/** Accept JSON or one pasted JSON-LD script wrapper; emit script-safe JSON only. */
+function normalizeCustomJsonLd($raw): ?string {
+    if (!is_string($raw) || trim($raw) === '') {
+        return null;
+    }
+    $raw = trim($raw);
+    if (preg_match('~^<script\b[^>]*>\s*(.*?)\s*</script>\s*$~is', $raw, $matches)) {
+        $raw = $matches[1];
+    }
+    try {
+        $schema = json_decode($raw, false, 512, JSON_THROW_ON_ERROR);
+    } catch (JsonException $e) {
+        return null;
+    }
+    if (!is_object($schema) && !is_array($schema)) {
+        return null;
+    }
+    return json_encode($schema, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS |
+        JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR);
+}
